{
  "name": "douyin-chat-mac",
  "version": "1.0.2",
  "description": "抖音桌面聊天（macOS）— Electron 客户端，可插拔适配器架构",
  "main": "./out/main/index.js",
  "author": "local",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --reporter=verbose",
    "probe": "node scripts/probe.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:dir": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "dist:all": "npm run build && electron-builder --mac --arm64 --win --x64 --linux --x64"
  },
  "dependencies": {
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
